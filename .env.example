# --- Aplicación ---
APP_NAME="DevPlay API"
APP_ENV=dev
APP_DEBUG=true

# --- Base de datos (PostgreSQL) ---
# Opción A (recomendada en local): Postgres propio de usuario en :55432
#   ./scripts/dev-db.sh start
DATABASE_URL=postgresql+psycopg://erick@127.0.0.1:55432/devplay_api
# Opción B: Postgres del sistema (requiere permisos CREATEDB):
# DATABASE_URL=postgresql+psycopg:///devplay_api?host=/var/run/postgresql
# Opción C: Docker (docker compose up db):
# DATABASE_URL=postgresql+psycopg://erick:devplay@127.0.0.1:5433/devplay_api

# --- JWT ---
# Generar con: openssl rand -base64 48
JWT_SECRET=cambiate-esta-clave-en-produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (JSON, sin espacios) ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:81"]

# --- SMTP (opcional) ---
# Sin configurar → modo demo: los códigos van al log y a `demoCode` en la respuesta.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASS=tu-app-password
# MAIL_FROM="DevPlay <no-reply@devplay.app>"

# --- Realtime (firma HMAC del handshake Socket.io) ---
# Generar con: openssl rand -base64 48
# REALTIME_SECRET=      # si falta, se usa JWT_SECRET

# --- Pixel Buddy (GLM vía Z.ai, API compatible con OpenAI) ---
# Clave gratis en: https://z.ai/manage-apikey/apikey-list
# Sin clave, POST /buddy responde en modo demo.
# ZAI_API_KEY=
# ZAI_MODEL=glm-4.5-flash
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
