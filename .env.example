# --- Aplicación ---
APP_NAME="DevPlay API"
APP_ENV=dev
APP_DEBUG=true

# --- Base de datos (PostgreSQL) ---
# Opción A (recomendada en local): Postgres propio de usuario en :55432
#   ./scripts/dev-db.sh start
DATABASE_URL=postgresql+psycopg://erick@127.0.0.1:55432/devplay_api
# Opción B: Postgres del sistema (requiere permisos CREATEDB):
# DATABASE_URL=postgresql+psycopg:///devplay_api?host=/var/run/postgresql
# Opción C: Docker (docker compose up db):
# DATABASE_URL=postgresql+psycopg://erick:devplay@127.0.0.1:5433/devplay_api

# --- JWT ---
# Generar con: openssl rand -base64 48
JWT_SECRET=cambiate-esta-clave-en-produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (JSON, sin espacios) ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:81"]
